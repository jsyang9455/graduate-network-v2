# Environment Variables
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=graduate_network
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File storage (REQ-PLT-004)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_ENDPOINT=
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Local DX: if macOS AirPlay holds 5000, use PORT=5050 and set
# localStorage.jjobb_api_base = 'http://localhost:5050/api' in the browser.
