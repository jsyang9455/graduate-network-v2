# Copy to `.env` for docker compose / local ops. Do NOT commit `.env`.
# REQ-NFR-010 — no hardcoded JWT in docker-compose.yml.

# Postgres — used by both compose `postgres` (POSTGRES_*) and `backend` (DB_*).
# POSTGRES_* only apply on first `postgres_data` volume create.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=graduate_network

# Required for backend container
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRE=7d

# Optional: local API when AirPlay holds 5000
# PORT=5050

# Host port for frontend nginx (compose publishes this → container :80).
# Default 8090 for AWS EC2 (avoids host :80 conflict). SG must allow this port.
FRONTEND_PORT=8090
# Then browse http://<IP>:8090/
